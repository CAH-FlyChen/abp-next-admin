<%@ CodeTemplate Language="c#" TargetLanguage="JScript" Description="Demonstrates the most basic template." %>
<%@ Property Name="ModuleName" Type="System.String" Default="SampleString" Category="Options" Description="模块名称" %>
<%@ Property Name="EntityName" Type="System.String" Default="SampleString" Category="Options" Description="功能名称" %>
// This class generated by CodeSmith on <%= DateTime.Now.ToLongDateString() %>

//系统模块
import type { Ref } from 'vue';
import type { TabFormSchema, TabFormActionType } from '/@/components/Form/src/types/form';
import { unref, computed, watch, createVNode } from 'vue';
import { useLocalization } from '/@/hooks/abp/useLocalization';
import { cloneDeep } from 'lodash-es';
import { listToTree } from '/@/utils/helper/treeHelper';

//自有模块
import { getList, create, update } from '/@/api/<%=ModuleName.ToLower()%>/<%=EntityName.ToLower()%>';
import { <%=EntityName%>, Update<%=EntityName%>, Create<%=EntityName%> } from '/@/api/<%=ModuleName.ToLower()%>/<%=EntityName.ToLower()%>/model';

interface Use<%=EntityName%>FormContext {
  <%=EntityName.ToLower()%>Model: Ref<<%=EntityName%>>;
  formElRef: Ref<Nullable<TabFormActionType>>;
}

export function use<%=EntityName%>FormContext({ <%=EntityName.ToLower()%>Model, formElRef }: Use<%=EntityName%>FormContext) {
  console.log("module is");
  console.log(<%=EntityName.ToLower()%>Model);

  const { L } = useLocalization(['AppPlatform','System','<%=ModuleName%>']);

  function getBasicFormSchemas(): TabFormSchema[] {
    return [
      {
        tab: L('DisplayName:Basic'),
        field: 'id',
        component: 'Input',
        label: 'id',
        colProps: { span: 24 },
        ifShow: false,
        required:true
      },
      {
        tab: L('DisplayName:Basic'),
        field: 'name',
        component: 'Input',
        label: L('DisplayName:Name'),
        colProps: { span: 24 },
        required: true,
      },
    ];
  }

  const getFormSchemas = computed((): TabFormSchema[] => {
    return [...getBasicFormSchemas()];
  });

  const formTitle = computed((): string => {
    const <%=EntityName.ToLower()%> = unref(<%=EntityName.ToLower()%>Model);
    if(!<%=EntityName.ToLower()%>) return "";
    if (<%=EntityName.ToLower()%>.id) {
      return L('Menu:EditByName', [<%=EntityName.ToLower()%>.name] as Recordable);
    }
    return L('Menu:AddNew');
  });

  /* 使用此填充下拉列表
  async function fetch<%=EntityName%>Resource() {
    removeAllParentMenus();
    const formEl = unref(formElRef);
    const { items } = await getList({});
    const treeData = listToTree(items, { id: 'code', pid: 'parentCode' });
    const region = unref(regionModel);
    formEl?.updateSchema({
      field: 'parentCode',
      defaultValue: region.parentCode,
      componentProps: { treeData },
    });
  }
  */

  function handleFormSubmit() {
    const formEl = unref(formElRef);
    return formEl?.validate().then(() => {
      debugger;
      const model = unref(<%=EntityName.ToLower()%>Model);
      const input = formEl?.getFieldsValue();
      return model.id
        ? update(model.id, cloneDeep(input) as Update<%=EntityName%>)
        : create(cloneDeep(input) as Create<%=EntityName%>);
    });
  }

  watch(
    () => unref(<%=EntityName.ToLower()%>Model),
    (newModel) => {
      const formEl = unref(formElRef);
      formEl?.resetFields();
      formEl?.setFieldsValue(newModel);
    },
    { immediate: true },
  );

  return {
    formTitle,
    getFormSchemas,
    handleFormSubmit,
    //fetch<%=EntityName%>Resource,
  };
}



<script runat="template">
public string GetFileName()
{
    return "use"+EntityName+"FormContext.ts";
}
</script>