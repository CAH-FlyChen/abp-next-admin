<%@ CodeTemplate Language="c#" TargetLanguage="JScript" Description="Demonstrates the most basic template." %>
<%@ Property Name="ModuleName" Type="System.String" Default="SampleString" Category="Options" Description="模块名称" %>
<%@ Property Name="EntityName" Type="System.String" Default="SampleString" Category="Options" Description="功能名称" %>
// This class generated by CodeSmith on <%= DateTime.Now.ToLongDateString() %>


<template>
  <div>
    <BasicTable @register="registerTable">
      <template #toolbar>
        <a-button v-auth="['<%=ModuleName%>.<%=EntityName%>.Create']" type="primary" @click="handleAddNew">{{
          L('AddNew')
        }}</a-button>
      </template>
      <template #bodyCell="{ column, record }">
        <template v-if="column.key === 'name'">
          <span>{{ record.name}}</span>
        </template>
        <template v-else-if="column.key === 'action'">
          <TableAction
            :actions="[
              //{
              //  auth: '<%=ModuleName%>.<%=EntityName%>.Create',
              //  label: L('AddNew'),
              //  icon: 'ant-design:plus-outlined',
              //  onClick: handleAddNew.bind(null, record),
              //},
              {
                auth: '<%=ModuleName%>.<%=EntityName%>.Update',
                label: L('Edit'),
                icon: 'ant-design:edit-outlined',
                onClick: handleEdit.bind(null, record),
              },
              {
                auth: '<%=ModuleName%>.<%=EntityName%>.Delete',
                color: 'error',
                label: L('Delete'),
                icon: 'ant-design:delete-outlined',
                onClick: handleDelete.bind(null, record),
              },
            ]"
          />
        </template>
      </template>
    </BasicTable>
    <<%=EntityName%>Drawer @register="registerDrawer" @change="handleChange" :framework="useFramework" />
  </div>
</template>

<script lang="ts" setup>
  // 系统组件
  import { ref } from 'vue';
  import { useMessage } from '/@/hooks/web/useMessage';
  import { useLocalization } from '/@/hooks/abp/useLocalization';
  import { BasicTable, useTable, TableAction } from '/@/components/Table';
  import { useDrawer } from '/@/components/Drawer';
  //import { listToTree } from '/@/utils/helper/treeHelper';
  
  // 自有组件  
  import { getDataColumns } from './<%=EntityName%>Data';
  import { getSearchFormSchemas } from './ModalData';
  import { getList, getById, deleteById } from '/@/api/<%=ModuleName.ToLower()%>/<%=EntityName.ToLower()%>';
  import <%=EntityName%>Drawer from './<%=EntityName%>Drawer.vue';

  const { createMessage, createConfirm } = useMessage();
  const { L } = useLocalization(['AppPlatform', 'AbpUi', 'System','<%=ModuleName%>']);

  const useFramework = ref('');
  const [registerTable, { reload }] = useTable({
    rowKey: 'code',
    title: L('<% = "DisplayName:"+EntityName %>'),
    columns: getDataColumns(),
    api: getList,
    beforeFetch: (request) => {
      // 子组件需要此参数,拦截一下
      useFramework.value = request.framework;
      return request;
    },
    /*
    afterFetch: (result) => {
      return listToTree(result, {
        id: 'code',
        pid: 'parentCode',
      });
    },
    */
    pagination: false,
    striped: false,
    useSearchForm: true,
    showTableSetting: true,
    bordered: true,
    showIndexColumn: false,
    canResize: false,
    formConfig: getSearchFormSchemas(),
    actionColumn: {
      width: 280,
      title: L('Actions'),
      dataIndex: 'action',
    },
  });

  const [registerDrawer, { openDrawer }] = useDrawer();

  function handleAddNew(record?: Recordable) {
    openDrawer(true, {});
  }

  function handleEdit(record: Recordable) {
    getById(record.id).then((data) => {
      openDrawer(true, data);
    });
  }

  function handleDelete(record: Recordable) {
    createConfirm({
      iconType: 'warning',
      title: L('AreYouSure'),
      content: L('ItemWillBeDeletedMessageWithFormat', [record.name]),
      okCancel: true,
      onOk: () => {
        return deleteById(record.id).then(() => {
          createMessage.success(L('SuccessfullyDeleted'));
          reload();
        });
      },
    });
  }

  function handleChange() {
    console.log("on handle change called");
    reload();
  }
</script>


<script runat="template">
public string GetFileName()
{
    return EntityName+"Table.ts";
}
</script>