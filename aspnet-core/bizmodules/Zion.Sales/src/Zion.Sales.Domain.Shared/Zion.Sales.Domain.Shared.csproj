  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded"  />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Sales\*.json" />
    <Content Remove="Localization\Sales\*.json" />
  </ItemGroup>

</Project>
